# Server
PORT=3000
NODE_ENV=production

# MariaDB — use the Docker Compose service name as host
DB_HOST=mariadb
DB_PORT=3306
DB_USER=hermes
DB_PASSWORD=hermes
DB_NAME=hermes

# Optional pool tuning
DB_POOL_SIZE=10
DB_CONNECTION_TIMEOUT_MS=10000

# MariaDB initialization variables
MARIADB_ROOT_PASSWORD=hermes
MARIADB_DATABASE=hermes
MARIADB_USER=hermes
MARIADB_PASSWORD=hermes

# JWT Authentication secrets
JWT_SECRET=hermes_jwt_secret_key_for_dev
REFRESH_TOKEN_SECRET=hermes_refresh_token_secret_key_for_dev

